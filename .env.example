# Referência somente para mantenedores que executam o projeto fora da Lovable.
# O aluno que usa Remix não cria .env, banco ou projeto Supabase. A Lovable
# recria no Remix os seis bindings públicos gerados do .env versionado; nunca
# substitua esses bindings por valores de outro projeto e nunca inclua service role.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Identidade e suporte opcionais
VITE_APP_URL=
VITE_SUPPORT_WHATSAPP=
VITE_SUPPORT_WHATSAPP_DISPLAY=
VITE_LEGAL_NAME=
VITE_LEGAL_DOCUMENT=
VITE_LEGAL_EMAIL=
VITE_LEGAL_ADDRESS=
VITE_OG_IMAGE_URL=
VITE_VAPID_PUBLIC_KEY=

# Integrações (WhatsApp, Google, Stripe) são salvas em Master → Integrações.
# As variáveis abaixo são apenas fallback de compatibilidade no servidor.
# O Remix não copia esses valores.

# Obrigatórios para o WhatsApp atual antes de gerar QR/código de pareamento:
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=

# Obrigatórios para o Google OAuth atual; o callback do clone também precisa
# estar autorizado no provedor Google:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Opcionais: configure somente o provedor de cobrança usado pelo clone.
# Sem um token e uma URL de checkout no plano, o proprietário ainda pode usar
# o sistema, mas vendas não liberarão clientes automaticamente:
# KIWIFY_WEBHOOK_TOKEN=
# CAKTO_WEBHOOK_TOKEN=
# PERFECTPAY_WEBHOOK_TOKEN=

# Lido por recursos server-side do projeto atual. Confirme o provisionamento
# no ambiente do clone antes de testar:
# SUPABASE_SERVICE_ROLE_KEY=

# A chave do Lovable AI é criada e gerenciada automaticamente pela Lovable em
# cada Remix. Não peça nem cadastre LOVABLE_API_KEY manualmente; confira apenas
# se o plano do clone possui créditos e limites disponíveis para o teste.
# Para chamar o gateway Lovable a partir da Vercel, configure no servidor Vercel
# LOVABLE_AI_PROXY_URL=https://conversa-kanban-compass.lovable.app/api/internal/lovable-ai-proxy
# e o mesmo segredo aleatório MARCIA_AI_PROXY_SECRET no runtime Lovable e Vercel.
# Nunca use prefixo VITE_ nesses valores e nunca os envie ao navegador.

# Opcionais ou dependentes do recurso habilitado:
# SUPPORT_WHATSAPP=
# VAPID_PRIVATE_KEY=
